## Local dev-only flags (copy to `.env.local`)
#
# Enable multi-card selection in the 3D table (pairs/straights testing).
# NOTE: This only affects 3D clickability/UX; rule validation is still enforced on "Đánh đã chọn".
NEXT_PUBLIC_SAM_DEV_MULTI_CARD_3D=1

# Casso bank webhook (set in Casso dashboard → Webhook URL: https://your-domain/api/casso/webhook)
# CASSO_SECURE_TOKEN=your-casso-secure-token
# NEXT_PUBLIC_CASSO_PUBLIC_EMBED_ID=your-casso-public-embed-id

